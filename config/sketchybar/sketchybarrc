#!/usr/bin/env bash
# Modeled on ryota2357/dotfiles (github.com/ryota2357/dotfiles/tree/master/sketchybar),
# per https://ryota2357.com/blog/2026/sketchybar-setup/. Label font substitutes the
# author's PleckJP (not installed here) for Osaka, a built-in macOS Japanese font, per
# the author's own noted alternative. Icons are SF Symbols, rendered by the system
# default font (no icon.font.family override needed).

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# https://felixkratz.github.io/SketchyBar/config/bar
bar=(
  position=top
  height=40
  color=0x00000000
  topmost=window
  sticky=on
)
sketchybar --bar "${bar[@]}"

##### Changing Defaults #####
# https://felixkratz.github.io/SketchyBar/config/items
default=(
  label.font='Osaka:Regular-Mono:16'
  label.color=0xffffffff
  label.padding_left=2
  label.padding_right=10
  icon.font.size=18
  icon.color=0xffffffff
  icon.padding_left=10
  icon.padding_right=2
  popup.background.color=0x6a002b36
  popup.background.border_width=1
  popup.background.border_color=0x48ffffff
  popup.background.corner_radius=3
  popup.blur_radius=10
)
sketchybar --default "${default[@]}"

add_item() {
  local name="$1"
  local position="$2"
  shift 2
  local args=("$name")
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == --* ]]; then
      args+=("$1" "$name")
    else
      args+=("$1")
    fi
    shift
  done
  sketchybar --add item "$name" "$position" --set "${args[@]}"
}
add_bracket() {
  local name="$1"
  shift
  local config=(
    blur_radius=10
    background.height=32
    background.color=0x6a002b36
    background.corner_radius=8
    background.border_width=1
    background.border_color=0x48ffffff
  )
  sketchybar --add bracket "$name" "$@" --set "$name" "${config[@]}"
}
_SPACER_COUNT=0
add_spacer() {
  _SPACER_COUNT=$((_SPACER_COUNT + 1))
  local name="spacer.$_SPACER_COUNT"
  sketchybar --add item "$name" "$1" --set "$name" width=8
}

########## Events ##########

sketchybar --add event aerospace_workspace_change
sketchybar --add event date_boundary

########## Left Items ##########

# Workspaces
add_item workspace.icon left \
  icon='􀏧' \
  icon.font.size=14 \
  icon.padding_right=5 \
  icon.color=0xffffd54f \
  label.drawing=off
WORKSPACE_APP_SLOTS=3
for sid in {1..9} 0; do
  for slot in $(seq 1 $WORKSPACE_APP_SLOTS); do
    add_item "workspace.$sid.app$slot" left \
      icon.drawing=off \
      icon.font='sketchybar-app-font:Regular:16.0' \
      icon.padding_left=2 \
      icon.padding_right=2 \
      label.drawing=off \
      click_script="aerospace workspace $sid"
  done
  add_item "workspace.$sid" left \
    icon.drawing=off \
    label="$sid" \
    label.font.size=18 \
    label.padding_right=10 \
    label.padding_left=6 \
    script="$PLUGIN_DIR/workspace.sh" \
    click_script="aerospace workspace $sid" \
    update_freq=2 \
    --subscribe aerospace_workspace_change
done
add_bracket workspace_bracket '/workspace\..*/'

########## Right Items ##########

# Time & Date
add_item time right \
  icon='􀐫' \
  icon.color=0xff64b5f6 \
  script="$PLUGIN_DIR/time.sh" \
  update_freq=1 \
  label.width=80
add_item date right \
  icon='􀉉' \
  icon.color=0xffffb74d \
  script="$PLUGIN_DIR/date.sh" \
  --subscribe system_woke date_boundary
add_bracket datetime_bracket date time

# Spacer
add_spacer right

# Battery
add_item battery right \
  script="$PLUGIN_DIR/battery.sh" \
  update_freq=30 \
  --subscribe power_source_change
add_bracket battery_bracket battery

# Spacer
add_spacer right

# Volume (icon turns Bluetooth-blue when the default audio output is a
# Bluetooth device, e.g. AirPods)
add_item volume right \
  icon.color=0xffff5252 \
  script="$PLUGIN_DIR/volume.sh" \
  icon.width=36 \
  update_freq=3 \
  --subscribe volume_change
add_bracket volume_bracket volume

# Spacer
add_spacer right

# Wi-Fi
add_item wifi right \
  icon.color=0xff4dd0e1 \
  script="$PLUGIN_DIR/wifi.sh" \
  update_freq=2 \
  --subscribe wifi_change
add_bracket wifi_bracket wifi

# Spacer
add_spacer right

# CPU
add_item cpu right \
  icon='􀫥' \
  script="$PLUGIN_DIR/cpu.sh" \
  update_freq=5 \
  label.padding_right=16
add_bracket sysinfo_bracket cpu

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
