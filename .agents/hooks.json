{
  "tab-status": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ~/.claude/set-tab-status.sh running && echo '{}'"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ~/.claude/set-tab-status.sh waiting && echo '{}'"
      }
    ]
  }
}
